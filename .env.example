# Optional: base URL of a running Pulsee bot status endpoint.
# When set, /api/status proxies live bot data from:
#   ${PULSEE_BOT_API_URL}/api/status
# The bot exposes this on port 5100 by default (STATUS_PORT to change).
# Leave unset to run in demo mode with sample data.
# PULSEE_BOT_API_URL=http://localhost:5100
